# Read by `make mcp` (default ./.env, or ENV_FILE=path). Copy to .env and fill in.
# .env is gitignored. A variable already exported in your shell wins over this file.
#
# Tokens do NOT go here. Keep them in the Keychain (Linux: secret-tool) and export them
# from ~/.zprofile by reading them from there, never as plain text: README.md, "First 10
# minutes", Tokens, has the commands. The servers read them from the shell Claude Code
# starts in, and make mcp refuses a token it only finds in this file.
#   variable                       Keychain item      what it is
#   CONFLUENCE_TOKEN               confluence-token   personal access token from your Confluence profile
#   JIRA_TOKEN                     jira-token         the same for Jira (optional)
#   GITHUB_PERSONAL_ACCESS_TOKEN   github-token       fine-grained, scoped to the repos you use (opt-in server)

# Self-hosted Confluence base URL.
CONFLUENCE_URL=
# Self-hosted Jira base URL. Optional: the Confluence tools work without it.
JIRA_URL=
# GCP project for the BigQuery server. GOOGLE_CLOUD_PROJECT wins if set; gcloud config is last.
GCP_PROJECT=
